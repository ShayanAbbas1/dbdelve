[clickhouse] alter update and delete
  |ALTER TABLE `db`.`t` UPDATE `a` = 'new' WHERE `k` = '1' AND toString(`f`) = '1.5' AND `n` IS NULL SETTINGS mutations_sync = 2;|
  |DELETE FROM `db`.`t` WHERE `k` = '1' AND toString(`f`) = '1.5' AND `n` IS NULL;|
  = write_on=false select=false classify=ReadWrite [] gate ro=Some(Upgrade(ReadWrite)) rw=None full=None matches_key[k+f+n]=false matches_key[k+f]=false row_guard=(none)

[clickhouse] alter modify
  |ALTER TABLE `db`.`t` MODIFY COLUMN `a` String|
  = write_on=false select=false classify=Full [] gate ro=Some(Upgrade(Full)) rw=Some(Upgrade(Full)) full=None matches_key[k+f+n]=false matches_key[k+f]=false row_guard=(none)

[clickhouse] backslash before a quote in a name
  |DELETE FROM `db`.`t` WHERE `k\\` = '1' AND `n` IS NULL -- `|
  = write_on=false select=false classify=Full [Unreadable] gate ro=Some(Upgrade(Full)) rw=Some(Upgrade(Full)) full=Some(RunOnce) matches_key[k+f+n]=false matches_key[k+f]=false row_guard=(none)

[clickhouse] delete, line comment
  |DELETE FROM `db`.`t` WHERE `k` = '1' AND toString(`f`) = '1.5' AND `n` IS NULL -- c|
  = write_on=false select=false classify=ReadWrite [] gate ro=Some(Upgrade(ReadWrite)) rw=None full=None matches_key[k+f+n]=false matches_key[k+f]=false row_guard=(none)

[clickhouse] delete, nested comment
  |DELETE FROM `db`.`t` WHERE `k` = '1' /* /* */ AND `n` IS NULL */|
  = write_on=false select=false classify=ReadWrite [] gate ro=Some(Upgrade(ReadWrite)) rw=None full=None matches_key[k+f+n]=false matches_key[k+f]=false row_guard=(none)
