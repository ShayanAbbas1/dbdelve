[postgres] plain => |select\u{a}  a,\u{a}  b\u{a}from\u{a}  t\u{a}where\u{a}  x = 1 -- keep\u{a}order by\u{a}  a|
[postgres] two statements => |select\u{a}  1;\u{a}select\u{a}  2;|
[postgres] two statements spaced => |select\u{a}  1;\u{a}\u{a}select\u{a}  2|
[postgres] comment only => |-- only a comment|
[postgres] empty => ||
[postgres] block comment => |select\u{a}  /* a ; b */\u{a}  1|
[postgres] backslash literal => error: |Not formatting: a string, quoted name or comment does not end.|
