[postgres] read_only=true => |SET default_transaction_read_only = on|
[postgres] read_only=false => |SET default_transaction_read_only = off|
[mysql] read_only=true => |SET SESSION TRANSACTION READ ONLY|
[mysql] read_only=false => |SET SESSION TRANSACTION READ WRITE|
