[mssql] quoted names => |select\u{a}  `a`,\u{a}  "b",\u{a}  [c]\u{a}from\u{a}  t|
[mssql] placeholders => |select\u{a}  *\u{a}from\u{a}  t\u{a}where\u{a}  a = $1\u{a}  and b = ?\u{a}  and c = :name\u{a}  and d = @p1\u{a}  and e = % s|
[mssql] dollar quote => error: |Not formatting: a dollar-quoted body would be rewritten.|
[mssql] unended string => error: |Not formatting: a string, quoted name or comment does not end.|
[mssql] unended comment => error: |Not formatting: a string, quoted name or comment does not end.|
[mssql] unended identifier => error: |Not formatting: a string, quoted name or comment does not end.|
[mssql] very long line => |select\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  a,\u{a}  b\u{a}from\u{a}  t|
[mssql] go separator => |select\u{a}  1\u{a}GO\u{a}select\u{a}  [x]\u{a}from\u{a}  [t]|
[mssql] go with count => |select\u{a}  1\u{a}go 5\u{a}select\u{a}  2|
[mssql] go inline => |select\u{a}  1\u{a}GO|
[mongodb] find => |db.getCollection("a").find({ a: 1, b: { $gt: 2 } })|
[mongodb] multi-line find => |db.getCollection("a")\u{a}  .find({\u{a}    a: 1,\u{a}    b: { $gt: 2 }\u{a}  })\u{a}  .limit(5)|
[mongodb] unterminated => error: |Not formatting: a statement in the buffer does not parse.|
[mongodb] empty => ||
[redis] get => error: |Not formatting: a Redis command is one line, as typed.|
[redis] empty => error: |Not formatting: a Redis command is one line, as typed.|
